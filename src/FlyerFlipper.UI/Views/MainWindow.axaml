<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FlyerFlipper.UI.ViewModels"
        xmlns:views="using:FlyerFlipper.UI.Views"
        xmlns:viewport="using:FlyerFlipper.Core.Viewport"
        xmlns:controls="using:Avalonia.Controls"
        mc:Ignorable="d"
        x:Class="FlyerFlipper.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Flyer Flipper"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400"
        SystemDecorations="None"
        Background="{DynamicResource SystemChromeMediumLowColor}">

  <!--
    MenuItem.InputGesture only displays the shortcut; these bindings make the keys work.
    Single-image navigation keys (Left/Right/Escape) are handled in code-behind.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding ToggleOrientationCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding ToggleViewportModeCommand}"/>
  </Window.KeyBindings>

  <!--
    Root Panel so the resize grips can overlay the content. The window draws its own chrome
    (decision 20): SystemDecorations="None" means no OS frame, title bar, or resize border.
  -->
  <Panel>
  <DockPanel LastChildFill="True">
    <views:CaptionBar DockPanel.Dock="Top"/>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Toggle Orientation"
                  Command="{Binding ToggleOrientationCommand}"
                  InputGesture="Ctrl+Shift+O"/>
        <MenuItem Header="Toggle _Viewport Mode (Grid / Single Image)"
                  Command="{Binding ToggleViewportModeCommand}"
                  InputGesture="Ctrl+Shift+V"/>
        <Separator/>
        <!-- Display-only scaling of the single-image view (decision 15d). -->
        <MenuItem x:Name="ImageScalingMenu" Header="Image _Scaling">
          <MenuItem Header="_Fit to Window" ToggleType="Radio" GroupName="ImageScaling"
                    IsChecked="{Binding IsScaleFitToWindow, Mode=OneWay}"
                    Command="{Binding SetScaleModeCommand}"
                    CommandParameter="{x:Static viewport:ViewportScaleMode.FitToWindow}"/>
          <MenuItem Header="Fit _without Enlarging" ToggleType="Radio" GroupName="ImageScaling"
                    IsChecked="{Binding IsScaleFitWithoutEnlarging, Mode=OneWay}"
                    Command="{Binding SetScaleModeCommand}"
                    CommandParameter="{x:Static viewport:ViewportScaleMode.FitWithoutEnlarging}"/>
          <MenuItem Header="_Stretch to Fill" ToggleType="Radio" GroupName="ImageScaling"
                    IsChecked="{Binding IsScaleStretchToFill, Mode=OneWay}"
                    Command="{Binding SetScaleModeCommand}"
                    CommandParameter="{x:Static viewport:ViewportScaleMode.StretchToFill}"/>
          <MenuItem Header="_Actual Size" ToggleType="Radio" GroupName="ImageScaling"
                    IsChecked="{Binding IsScaleActualSize, Mode=OneWay}"
                    Command="{Binding SetScaleModeCommand}"
                    CommandParameter="{x:Static viewport:ViewportScaleMode.ActualSize}"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
      </MenuItem>
    </Menu>

    <DockPanel LastChildFill="True">
      <Border DockPanel.Dock="{Binding ControlsDock}"
              Background="{DynamicResource SystemChromeLowColor}"
              BorderBrush="{DynamicResource SystemChromeDisabledLowColor}"
              BorderThickness="{Binding ControlsBorderThickness}"
              Width="{Binding ControlsWidth}"
              MinHeight="120" MinWidth="240"
              Padding="16">
        <!-- Folder input stays above the processor tabs (decision 15a). -->
        <DockPanel LastChildFill="True">
          <views:ImageSourceView DockPanel.Dock="Top" DataContext="{Binding ImageSource}"/>
          <views:ProcessorTabHost Margin="0,12,0,0" DataContext="{Binding ProcessorTabs}"/>
        </DockPanel>
      </Border>

      <!-- Visibility lives on wrapper panels: a child's own bindings resolve against its child DataContext. -->
      <Panel Background="{DynamicResource SystemChromeMediumLowColor}">
        <Panel IsVisible="{Binding IsGridMode}">
          <views:ThumbnailGridView DataContext="{Binding ThumbnailGrid}"/>
        </Panel>
        <Panel IsVisible="{Binding IsSingleMode}">
          <views:SingleImageView DataContext="{Binding SingleImage}"/>
        </Panel>
      </Panel>
    </DockPanel>
  </DockPanel>

    <!--
      Resize grips, replacing the OS resize border. Only these thin cells are hit-testable — the Grid
      and its centre cell have no background, so clicks there fall through to the content beneath.
      Hidden while maximized, where the OS owns the size.
    -->
    <Grid x:Name="ResizeGrips"
          RowDefinitions="5,*,5" ColumnDefinitions="5,*,5">
      <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
              Tag="{x:Static controls:WindowEdge.NorthWest}" PointerPressed="OnResizeGripPressed"/>
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="TopSide"
              Tag="{x:Static controls:WindowEdge.North}" PointerPressed="OnResizeGripPressed"/>
      <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
              Tag="{x:Static controls:WindowEdge.NorthEast}" PointerPressed="OnResizeGripPressed"/>

      <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="LeftSide"
              Tag="{x:Static controls:WindowEdge.West}" PointerPressed="OnResizeGripPressed"/>
      <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="RightSide"
              Tag="{x:Static controls:WindowEdge.East}" PointerPressed="OnResizeGripPressed"/>

      <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
              Tag="{x:Static controls:WindowEdge.SouthWest}" PointerPressed="OnResizeGripPressed"/>
      <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="BottomSide"
              Tag="{x:Static controls:WindowEdge.South}" PointerPressed="OnResizeGripPressed"/>
      <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
              Tag="{x:Static controls:WindowEdge.SouthEast}" PointerPressed="OnResizeGripPressed"/>
    </Grid>
  </Panel>

</Window>
