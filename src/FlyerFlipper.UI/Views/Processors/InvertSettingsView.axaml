<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlyerFlipper.UI.ViewModels.Processors"
             x:Class="FlyerFlipper.UI.Views.Processors.InvertSettingsView"
             x:DataType="vm:InvertSettingsViewModel">

  <StackPanel Spacing="6" Margin="0,8,0,0">
    <CheckBox Content="Invert colours" IsChecked="{Binding Enabled}"/>
    <TextBlock Text="Replaces each colour with its opposite. Transparency is left untouched."
               Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel>

</UserControl>
