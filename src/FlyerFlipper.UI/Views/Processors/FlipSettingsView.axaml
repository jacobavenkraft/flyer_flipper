<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlyerFlipper.UI.ViewModels.Processors"
             x:Class="FlyerFlipper.UI.Views.Processors.FlipSettingsView"
             x:DataType="vm:FlipSettingsViewModel">

  <StackPanel Spacing="6" Margin="0,8,0,0">
    <CheckBox Content="Flip image" IsChecked="{Binding Enabled}"/>

    <!-- Spelled out rather than "horizontal"/"vertical", which is read both ways. -->
    <StackPanel Margin="20,0,0,0" Spacing="4" IsEnabled="{Binding Enabled}">
      <CheckBox Content="Mirror left ↔ right" IsChecked="{Binding MirrorHorizontally}"/>
      <CheckBox Content="Mirror top ↕ bottom" IsChecked="{Binding MirrorVertically}"/>
    </StackPanel>

    <TextBlock Text="Both together are the same as rotating 180°."
               Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel>

</UserControl>
